{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": "portfolio_website",
  "devCommand": "echo 'Static site - no dev server needed'",
  "installCommand": "echo 'No dependencies to install'",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/Cybersecurity_Threat_Report_Task1_Naman Verma.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Cybersecurity_Threat_Report_Task1_Naman_Verma.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}